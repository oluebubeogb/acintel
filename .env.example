# ============================================================================
# AcIntel (Phases 1–6) — copy to .env for `docker compose up`, or paste these
# into Coolify → Environment Variables. Never commit the real .env.
# ============================================================================

# ---- Postgres (compose service "db") ----
POSTGRES_USER=acintel
POSTGRES_PASSWORD=change-me-to-a-long-random-string   # REQUIRED
POSTGRES_DB=acintel
# Only for running the API with npm outside compose:
DATABASE_URL=postgresql://acintel:change-me@localhost:5433/acintel

# ---- Redis (realtime pub/sub, login rate limit, counts) ----
# compose sets REDIS_URL=redis://redis:6379 itself; this is for npm runs.
REDIS_URL=redis://localhost:6379

# ---- Ports ----
WEB_HOST_PORT=3131          # the ONLY published port (Coolify: leave unset, it routes the domain to web:3000)
# docker-compose.dev.yml only:
API_HOST_PORT=4000
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379

# ---- Web -> API (server-side /api proxy, read at runtime; compose sets http://api:4000) ----
API_INTERNAL_URL=http://localhost:4000

# ---- Auth / sessions ----
COOKIE_SECURE=auto          # auto = Secure cookie when served over HTTPS (Coolify/Traefik). true|false to force.
TRUST_PROXY=loopback, linklocal, uniquelocal
LOGIN_MAX_FAILS=5           # failed attempts per account before a lockout window
LOGIN_MAX_PER_IP=30         # login attempts per IP per window
LOGIN_WINDOW_MINUTES=15

# ---- Seed (runs on every API start; idempotent) ----
SEED_ADMIN_EMAIL=admin@acintel.local
SEED_ADMIN_PASSWORD=Passw0rd!23   # change before go-live, then change it again in the app
SEED_DEMO=true              # false = only the admin + reference data (no demo users/agents/reports)
SEED_RESET=false            # true = WIPE data and reseed on next start (set back to false!)

# ---- Demo activity (moves live badges; turn off once Phase 7 Homeland data flows) ----
SIMULATE_ACTIVITY=true
SIMULATE_INTERVAL_MS=45000

# ---- Realtime / counters ----
COUNTS_CACHE_MS=2000        # memo for the counts query; pushes always compute fresh
AGENT_ONLINE_MINUTES=15     # agent counts as "online" if seen within N minutes

# ---- Incident media ----
# compose mounts the "uploads" volume at /data/uploads
UPLOAD_DIR=/data/uploads
MEDIA_MAX_MB=25

# ---- Maps (MapLibre GL + OpenStreetMap raster by default; no key needed) ----
# Option A: a full MapLibre style JSON (MapTiler, Stadia, self-hosted) — takes precedence:
MAP_STYLE_URL=
# Option B: a raster XYZ template:
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Google Maps: Google's terms do not allow using its tiles via raw XYZ in MapLibre.
# Use Google's Map Tiles API session tiles (needs GOOGLE_MAPS_API_KEY + a session token)
# or a MapTiler/Stadia style above. Reserved for a later swap — not read yet:
GOOGLE_MAPS_API_KEY=
# For heavy production traffic use your own/paid tile server (OSM tile policy).

# ---- AI assistant (OpenAI-compatible, e.g. RunPod vLLM: https://api.runpod.ai/v2/<id>/openai/v1) ----
# Empty key = offline placeholder that still answers counts/CSVs from the database.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_TOKENS=1024

# ---- Phase 7 (NOT active) — Homeland DataPort. Leave empty; the stub ignores them. ----
HOMELAND_BASE_URL=
HOMELAND_API_KEY=
